# Copy this file to ".env" and put your real values there.
# .env is listed in .gitignore - never commit your real connection string.

# MongoDB Atlas connection string (Atlas -> Database -> Connect -> Drivers)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/portfolioDB?retryWrites=true&w=majority

# Or, if MongoDB Community Server is installed locally:
# MONGO_URI=mongodb://127.0.0.1:27017/portfolioDB

PORT=5002
