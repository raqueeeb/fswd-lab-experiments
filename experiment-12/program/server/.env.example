# LOCAL TESTING ONLY: copy this file to "server/.env" (never commit .env).
# On Render, add the same keys in Dashboard -> your service -> Environment.

# MongoDB Atlas connection string (Atlas -> Database -> Connect -> Drivers)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/portfolioDB?retryWrites=true&w=majority

# Render sets PORT automatically; this value is only used on your computer
PORT=5004

# "production" on Render (quieter logs, generic error messages)
NODE_ENV=development

# Frontend origins allowed by CORS (comma separated).
# Only needed when the React app is hosted on a DIFFERENT domain (e.g. Vercel/Netlify).
CORS_ORIGIN=http://localhost:5173
